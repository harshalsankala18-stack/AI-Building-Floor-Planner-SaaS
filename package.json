{
  "name": "ai-floor-planner",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "AI-powered architectural floor plan generation and editing platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "preview:current": "pnpm --filter @ai-floor-planner/frontend run preview:current",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "vitest run --project integration",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "verify:release": "pnpm test && pnpm typecheck && pnpm build && pnpm lint",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "9.9.0",
    "prettier": "3.3.3",
    "turbo": "2.0.14",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.67.0",
    "vitest": "2.0.5"
  }
}
